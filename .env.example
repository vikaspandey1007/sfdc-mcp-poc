# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# No value in this file is a real secret; this documents shape only.

# Salesforce org (from Gate 1)
SF_MY_DOMAIN_URL=https://your-domain-dev-ed.develop.my.salesforce.com
SF_ECA_CONSUMER_KEY=

# Salesforce Hosted MCP endpoint (from Gate 1/2)
SF_MCP_SERVER_URL=https://api.salesforce.com/platform/mcp/v1/sobject-reads

# Google Gemini (from Gate 3) -- get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Pin the exact model ID after checking the current Flash-tier lineup live at
# aistudio.google.com/models -- do not guess/search for this, model names
# change and search results for them have proven unreliable (see
# docs/troubleshooting.md). Needs function-calling support + a free tier.
GOOGLE_GENAI_MODEL=
